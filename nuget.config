<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply-chain guard: only nuget.org, and every package must come from an
  explicitly mapped source. Blocks "helpful" agents from adding random feeds.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
